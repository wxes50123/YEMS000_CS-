;* リセット処理

        .section STACK_END,DATA,ALIGN=4
        .section P,CODE
        .glb _RESET
_RESET:
        mov.l   #0F030000h, r1              ; PSWの初期値(割り込みマスクレベルを最高に)
        mvtc    r1, psw

        ; CPU内蔵周辺の初期化

        mvtc    #00001000h, usp             ; スタックポインタを内蔵RAMに設定
        bsr     _ini_cpu

        ; Cの初期化ルーチンへ

        mvtc    #(TOPOF STACK_END), isp     ; 割り込み用含むスタックポインタを
        mvtc    #(TOPOF STACK_END), usp     ; STACKセクションの終わりに再設定
        bra     __INIT

        .end
