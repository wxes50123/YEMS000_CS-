;* 2020-03-16 Ported to Renesas RX72M                                      FY *
;* 2020-05-15 Fixed _ROM_VEC comments Reserved->GROUPIE0, IDEI->RXI1 etc.  FY *
;* 2020-05-15 Moved stack pointer initialization after ini_cpu()           FY *
;* 2020-11-18 Corrected fixed-vector table location FFFFFFD0 to FFFFFF80   FY *
;* 2022-06-17 Corrected initial value of PSW from 07030000h to 0F030000h   FY *
;* 2024-07-10 Modified interrupt vector table comment to note VECT section FY *
;* 2024-07-10 Fixed FIXEDVECT to EXCEPTVECT/RESETVECT for RXv2 or later    FY *
;* 2025-07-30 Added _inthdr/_int_sio0_rx/_tx/_er to _ROM_VEC               FY *
;******************************************************************************

;* 外部参照

        .glb _ini_cpu               ; CPU内蔵周辺の初期化
        .glb __INIT                 ; Cの初期設定ルーチン

;* 例外ベクタテーブル

        .section EXCEPTVECT,ROMDATA ; リンカでFFFFFF80番地に配置

        .lword -1                   ; FFFFFF80  reserved
        .lword -1                   ; FFFFFF84  reserved
        .lword -1                   ; FFFFFF88  reserved
        .lword -1                   ; FFFFFF8C  reserved
        .lword -1                   ; FFFFFF90  reserved
        .lword -1                   ; FFFFFF94  reserved
        .lword -1                   ; FFFFFF98  reserved
        .lword -1                   ; FFFFFF9C  reserved
        .lword -1                   ; FFFFFFA0  reserved
        .lword -1                   ; FFFFFFA4  reserved
        .lword -1                   ; FFFFFFA8  reserved
        .lword -1                   ; FFFFFFAC  reserved
        .lword -1                   ; FFFFFFB0  reserved
        .lword -1                   ; FFFFFFB4  reserved
        .lword -1                   ; FFFFFFB8  reserved
        .lword -1                   ; FFFFFFBC  reserved
        .lword -1                   ; FFFFFFC0  reserved
        .lword -1                   ; FFFFFFC4  reserved
        .lword -1                   ; FFFFFFC8  reserved
        .lword -1                   ; FFFFFFCC  reserved
        .lword -1                   ; FFFFFFD0  特権命令例外
        .lword -1                   ; FFFFFFD4  アクセス例外
        .lword -1                   ; FFFFFFD8  reserved
        .lword -1                   ; FFFFFFDC  未定義命令例外
        .lword -1                   ; FFFFFFE0  reserved
        .lword -1                   ; FFFFFFE4  単精度浮動小数点例外
        .lword -1                   ; FFFFFFE8  reserved
        .lword -1                   ; FFFFFFEC  reserved
        .lword -1                   ; FFFFFFE0  reserved
        .lword -1                   ; FFFFFFE4  reserved
        .lword -1                   ; FFFFFFF8  ノンマスカブル割り込み

        .section RESETVECT,ROMDATA  ; リンカでFFFFFFFC番地に配置

        .lword _RESET               ; FFFFFFFC  リセット

;* 割り込みベクタテーブル
;*
;* 割り込みベクタをROMに定義する場合は、アセンブル時にROMVECマクロに1を定義し、
;* 割り込みハンドラのシンボルを下記の「-1」の代わりに記述してください。また、
;* リンカのセクション指定でROM領域に「VECT」がない場合、それを加えてください。

      .IF ROMVEC != 0
        .section VECT,CODE,ALIGN=4  ; リンカで内蔵ROMに配置
        .glb    _ROM_VEC
        .glb    _inthdr
        .glb    _int_sio0_rx
        .glb    _int_sio0_tx
        .glb    _int_sio0_er
_ROM_VEC:
        .lword -1                   ;   0: 
        .lword -1                   ;   1: 
        .lword -1                   ;   2: 
        .lword -1                   ;   3: 
        .lword -1                   ;   4: 
        .lword -1                   ;   5: 
        .lword -1                   ;   6: 
        .lword -1                   ;   7: 
        .lword -1                   ;   8: 
        .lword -1                   ;   9: 
